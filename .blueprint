models:
    Admin: { email: 'string:255', status: 'enum:Success,pending,failed', timestamps: timestamps, relationships: { hasMany: CreditAgent } }
    Abonnement: { id_user: 'id foreign:users', id_project: 'id foreign:projects nullable', id_page: 'id foreign:pages nullable', status: 'enum:Success,pending,failed', ip_address: 'string:255 nullable', timestamps: timestamps }
    AskQuestion: { id_user: 'id foreign:users', response: 'enum:facebook,instagram,twitter,whatsapp,friend,other nullable', timestamps: timestamps }
    CategoryProject: { name: 'string:255', icone: 'string:255 nullable', status: 'enum:pending,Success,failed,waiting', color: 'string:255 nullable', timestamps: timestamps, relationships: { hasMany: Project } }
    Comment: { id_user: 'id foreign:users', id_publication: 'id foreign:publications nullable', id_project: 'id foreign:projects nullable', id_page: 'id foreign:pages nullable', body: longtext, status: 'enum:Success,pending,failed,waiting', timestamps: timestamps }
    Connected: { id_user: 'id foreign:users', ip_address: 'string:255 nullable', country: 'string:255', timestamps: timestamps }
    Contact: { name: 'string:191', email: 'string:191', message: text, timestamps: timestamps }
    Country: { name: 'string:255', sortname: 'string:255', phoneCode: integer, timestamps: timestamps }
    CreditAgent: { ref: 'string:255', id_user: 'id foreign:users', id_admin: 'bigInteger foreign:admins', status: 'enum:pending,Success,failed', amount: integer, currency: 'string:255', commentaire: 'longtext nullable', timestamps: timestamps }
    Currency: { name_abr: 'string:10 unique', name: 'string:100', timestamps: timestamps }
    Deconnected: { id_user: 'id foreign:users', ip_address: 'string:255 nullable', timestamps: timestamps }
    Fee: { name: 'string:255 nullable', type: 'enum:invest,don,studyFees,pub', value: integer, status: 'enum:pending,Success,failed,waiting', timestamps: timestamps, relationships: { hasMany: 'Payment, PaymentDonation' } }
    Job: { queue: 'string:500 nullable', payload: 'longtext nullable', attempts: tinyInteger, reserved_at: 'integer nullable', available_at: integer, created_at: integer }
    Like: { id_user: 'bigInteger nullable', ip_address: 'string:15 nullable', id_publication: 'id foreign:publications nullable', id_project: 'id foreign:projects nullable', id_page: 'id foreign:pages nullable', status: 'enum:Success,pending,failed,waiting', timestamps: timestamps }
